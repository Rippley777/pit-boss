{
  "license": "SEE LICENSE IN LICENSE",
  "name": "pit-boss",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "test": "playwright test",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "format": "prettier --write src tests *.ts *.json index.html",
    "desktop:build": "tauri build --bundles app",
    "release:desktop": "node scripts/macos-release.mjs",
    "release:mac": "node scripts/macos-release.mjs",
    "release:mac:check": "node scripts/macos-release.mjs --check",
    "release:mac:sign": "node scripts/macos-release.mjs --sign-only",
    "test:macos-release": "node --test scripts/macos-release.test.mjs"
  },
  "dependencies": {
    "@house-edge/analytics": "file:vendor/house-edge-analytics-0.1.1.tgz",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
